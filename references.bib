@article{mcmillan2026,
  title = {What 5000 Babies Can Tell Us about Developing Minds and How to Study Them},
  author = {McMillan, Brianna T. M. and Baumgartner, Heidi A. and Bergmann, Christina and Frank, Michael C. and Hamlin, J. Kiley and Kampis, Dora and Kline Struhl, Melissa and Ko, Eon-Suk and Kosie, Jessica E. and Lew-Williams, Casey and Lucca, Kelsey and Schuwerk, Tobias and Soderstrom, Melanie and Visser, Ingmar and Yuen, Francis L. and Zettersten, Martin and Byers-Heinlein, Krista},
  date = {2026-06-09},
  journaltitle = {Communications Psychology},
  shortjournal = {Commun. Psychol.},
  volume = {4},
  number = {1},
  pages = {92},
  publisher = {Nature Publishing Group},
  issn = {2731-9121},
  doi = {10.1038/s44271-026-00477-w},
  url = {https://www.nature.com/articles/s44271-026-00477-w},
  urldate = {2026-09-28},
  abstract = {A decade of ManyBabies research, testing thousands of babies across hundreds of labs, has shown that some, but not all findings in infant research replicate well. Collectively, these projects have shown that current methods carry limitations that larger samples alone cannot resolve. Here three lessons that point toward a more reliable, inclusive developmental science are presented.},
